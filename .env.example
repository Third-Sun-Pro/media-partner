APP_PASSWORD=your-password-here
ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001
PORT=3000

# Path to the agreements data folder. In production, MUST point outside the
# deploy folder (e.g. ../data) — Hostinger wipes the app directory on every
# deploy, so anything inside it (including the default ./data) gets lost.
DATA_DIR=../data
